+import {isOwner} from './profile.js';
+const fail=(message,status=400)=>{throw Object.assign(new Error(message),{status});};
+
+async function accountKey(request,env){
+ if(!isOwner(request,env))fail('请使用站点所有者账号登录',403);
+ const identity=env.OWNER_USER_ID?.trim()||env.OWNER_EMAIL?.trim().toLowerCase();
+ const hash=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(identity));
+ return 'account_settings:'+Array.from(new Uint8Array(hash)).map(x=>x.toString(16).padStart(2,'0')).join('');
+}
+export async function readAccountSettings(request,env){const key=await accountKey(request,env);const row=await env.DB.prepare('SELECT value FROM pointers WHERE key=?').bind(key).first();return row?JSON.parse(row.value):{version:0,personal:null,appearance:null,updated_at:null};}
+function validatePatch(patch){
+ if(!patch||typeof patch!=='object'||Array.isArray(patch)||!Object.keys(patch).length||Object.keys(patch).some(k=>!['personal','appearance'].includes(k)))fail('设置格式无效');
+ const out={};
+ if('personal'in patch){const p=patch.personal;if(!p||typeof p!=='object'||Object.keys(p).some(k=>!['name','tagline','avatar'].includes(k))||('name'in p&&(typeof p.name!=='string'||p.name.length>40))||('tagline'in p&&(typeof p.tagline!=='string'||p.tagline.length>80))||('avatar'in p&&(typeof p.avatar!=='string'||p.avatar.length>160000))||/[\u0000-\u001f]/.test(p.name+p.tagline))fail('个人资料格式无效');
+  if(p.avatar&&!/^preset:0[1-8]$/.test(p.avatar)&&!/^data:image\/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$/.test(p.avatar))fail('头像格式无效');
+  if(p.avatar?.startsWith('data:')){const encoded=p.avatar.split(',')[1];let bytes;try{bytes=Uint8Array.from(atob(encoded),c=>c.charCodeAt(0));}catch{fail('头像格式无效');}const png=bytes[0]===137&&bytes[1]===80&&bytes[2]===78&&bytes[3]===71,jpeg=bytes[0]===255&&bytes[1]===216,webp=String.fromCharCode(...bytes.slice(0,4))==='RIFF'&&String.fromCharCode(...bytes.slice(8,12))==='WEBP';if(!(p.avatar.startsWith('data:image/png;')&&png||p.avatar.startsWith('data:image/jpeg;')&&jpeg||p.avatar.startsWith('data:image/webp;')&&webp))fail('头像内容与格式不符');}
+  out.personal={};if('name'in p)out.personal.name=p.name.trim();if('tagline'in p)out.personal.tagline=p.tagline.trim();if('avatar'in p)out.personal.avatar=p.avatar;}
+ if('appearance'in patch){const p=patch.appearance;if(!p||Object.keys(p).some(k=>!['font','theme'].includes(k))||('font'in p&&!['system','serif','humanist','mono'].includes(p.font))||('theme'in p&&!['sage','paper','sand','mist'].includes(p.theme)))fail('显示设置格式无效');out.appearance={};if('font'in p)out.appearance.font=p.font;if('theme'in p)out.appearance.theme=p.theme;}
+ return out;
+}
+export async function saveAccountSettings(request,env,url,data){
+ const key=await accountKey(request,env);if(request.headers.get('Origin')!==url.origin)fail('请求来源无效',403);
+ if(!data||!Number.isSafeInteger(data.base_version)||data.base_version<0||data.base_version>=Number.MAX_SAFE_INTEGER)fail('设置版本无效');
+ const patch=validatePatch(data.patch),current=await readAccountSettings(request,env);
+ if(current.version!==data.base_version)fail('其他设备已更新设置，请重新打开个人中心核对后再保存。',409);
+ const next={...current,...('personal'in patch?{personal:{name:'',tagline:'',avatar:'',...current.personal,...patch.personal}}:{}),...('appearance'in patch?{appearance:{font:'system',theme:'sage',...current.appearance,...patch.appearance}}:{}),version:current.version+1,updated_at:new Date().toISOString()};
+ const result=await env.DB.prepare(`INSERT INTO pointers(key,value) SELECT ?,? WHERE ?=0 OR EXISTS(SELECT 1 FROM pointers WHERE key=? AND json_extract(value,'$.version')=?) ON CONFLICT(key) DO UPDATE SET value=excluded.value WHERE json_extract(pointers.value,'$.version')=?`).bind(key,JSON.stringify(next),data.base_version,key,data.base_version,data.base_version).run();
+ if(!result.meta?.changes)fail('其他设备已更新设置，请重新打开个人中心核对后再保存。',409);
+ return next;
+}
