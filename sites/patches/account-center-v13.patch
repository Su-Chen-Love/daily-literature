+import assert from 'node:assert/strict';
+import {database} from './d1-local.mjs';
+import {readAccountSettings,saveAccountSettings} from '../worker/account-settings.js';
+const DB=database(),env={DB,OWNER_EMAIL:'owner@example.test'},url=new URL('https://settings.example.test');
+const request=(email=env.OWNER_EMAIL,origin=url.origin)=>new Request(url,{headers:{'oai-authenticated-user-email':email,Origin:origin}});
+const read=()=>readAccountSettings(request(),env);
+const save=(version,patch)=>saveAccountSettings(request(),env,url,{base_version:version,patch});
+assert.equal((await read()).version,0);
+await assert.rejects(()=>readAccountSettings(request('other@example.test'),env),e=>e.status===403);
+await assert.rejects(()=>saveAccountSettings(request(env.OWNER_EMAIL,'https://evil.test'),env,url,{base_version:0,patch:{personal:{name:'Bad'}}}),e=>e.status===403);
+let state=await save(0,{personal:{name:'研究者',avatar:'preset:03'},appearance:{font:'humanist',theme:'mist'}});
+assert.equal(state.version,1);assert.equal(state.personal.avatar,'preset:03');assert.equal((await read()).appearance.theme,'mist');
+await assert.rejects(()=>save(0,{personal:{name:'stale'}}),e=>e.status===409);
+state=await save(1,{personal:{tagline:'跨设备资料'}});assert.equal(state.personal.name,'研究者');assert.equal(state.appearance.theme,'mist');
+const race=await Promise.allSettled([save(2,{personal:{name:'设备A'}}),save(2,{appearance:{font:'mono'}})]);assert.equal(race.filter(x=>x.status==='fulfilled').length,1);assert.equal((await read()).version,3);
+await assert.rejects(()=>save(3,{personal:{avatar:'https://evil.test/a.png'}}),e=>e.status===400);
+await assert.rejects(()=>save(3,{personal:{avatar:'data:image/png;base64,SGVsbG8='}}),e=>e.status===400);
+await assert.rejects(()=>save(3,{appearance:{font:'arbitrary'}}),e=>e.status===400);
+await assert.rejects(()=>save(3,{personal:{avatar:'preset:09'}}),e=>e.status===400);
+assert.equal((await read()).version,3);
+console.log('Account settings: owner isolation, CSRF, persistence, sparse field patches, CAS races, invalid avatars and stale-write refusal passed.');
+const {default:worker}=await import('../worker/index.js');
+const http=await worker.fetch(new Request(new URL('/api/account/settings',url),{headers:{'oai-authenticated-user-email':env.OWNER_EMAIL}}),env);
+assert.equal(http.status,200);assert.equal((await http.json()).version,3);
+const denied=await worker.fetch(new Request(new URL('/api/account/settings',url),{headers:{'oai-authenticated-user-email':'stranger@example.test'}}),env);assert.equal(denied.status,403);
+const csrf=await worker.fetch(new Request(new URL('/api/account/settings',url),{method:'POST',headers:{'oai-authenticated-user-email':env.OWNER_EMAIL,Origin:'https://other.test','Content-Type':'application/json'},body:JSON.stringify({base_version:3,patch:{personal:{name:'CSRF'}}})}),env);assert.equal(csrf.status,403);
+console.log('Account settings HTTP transport enforces owner identity and same-origin POST.');
+const {readFile}=await import('node:fs/promises');
+for(let n=1;n<=8;n++){
+ const path=`images/avatars/avatar-${String(n).padStart(2,'0')}.webp`;
+ const image=await worker.fetch(new Request(new URL('/static/'+path,url)),env);
+ assert.equal(image.status,200);assert.equal(image.headers.get('Content-Type'),'image/webp');assert.deepEqual(Buffer.from(await image.arrayBuffer()),await readFile('shared/static/'+path));
+}
+for(const name of ['MaShanZheng','ZCOOLKuaiLe']){
+ const response=await worker.fetch(new Request(new URL('/static/fonts/'+name+'-OFL.txt',url)),env);assert.equal(response.status,200);assert.ok((await response.text()).includes('SIL Open Font License'));
+}
+console.log('All eight WebP assets serve exact verified bytes; both font licenses accompany the served fonts.');
